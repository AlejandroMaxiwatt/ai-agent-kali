# Copia este fichero a `.env` y rellena los valores reales.
# El agente lo carga automáticamente al arrancar (python-dotenv).
# Cualquier herramienta lanzada por el agente hereda estas variables.
#
# IMPORTANTE:
# - No uses espacios alrededor del `=`.
# - Comillas opcionales. Si el valor lleva caracteres raros, ponlas dobles.
# - NUNCA hagas commit del .env real. El .env.example sí puede vivir en el repo.

# ──────────────────────────────────────────────────────────────────────
# Shodan
# CLI oficial: `pip install shodan`  ·  espera SHODAN_API_KEY o ~/.shodan/api_key
# ──────────────────────────────────────────────────────────────────────
SHODAN_API_KEY=

# ──────────────────────────────────────────────────────────────────────
# Censys (Search v2)
# CLI: `pip install censys`  ·  espera CENSYS_API_ID + CENSYS_API_SECRET
# Si tu cuenta usa "API tokens" del nuevo Censys Platform, ése es CENSYS_API_TOKEN.
# ──────────────────────────────────────────────────────────────────────
CENSYS_API_ID=
CENSYS_API_SECRET=
CENSYS_API_TOKEN=

# ──────────────────────────────────────────────────────────────────────
# Otras APIs típicas en recon (opcionales)
# ──────────────────────────────────────────────────────────────────────
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=
CHAOS_API_KEY=
GITHUB_TOKEN=
HUNTERIO_API_KEY=

# WPScan (https://wpscan.com/api)
WPSCAN_API_TOKEN=

# Have I Been Pwned
HIBP_API_KEY=
