# Copia este fichero a `.env` y rellena los valores reales.
# El agente lo carga automáticamente al arrancar (python-dotenv).
# Cualquier herramienta lanzada por el agente hereda estas variables.
#
# IMPORTANTE:
# - No uses espacios alrededor del `=`.
# - Comillas opcionales. Si el valor lleva caracteres raros, ponlas dobles.
# - NUNCA hagas commit del .env real. El .env.example sí puede vivir en el repo.

# ──────────────────────────────────────────────────────────────────────
# Backend de modelo
# ──────────────────────────────────────────────────────────────────────
# URL OpenAI-compatible de LM Studio. Ejemplos:
#   LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1      (LM Studio en esta máquina)
#   LMSTUDIO_BASE_URL=http://it1-pc:1234/v1         (otra máquina/tailnet)
#   LMSTUDIO_BASE_URL=http://192.168.1.20:1234/v1   (LAN)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Modelo a usar si el backend no expone ninguno.
# MODEL_NAME_FALLBACK=qwen/qwen3.6-27b

# Ollama Cloud (endpoint OpenAI-compatible). Requiere API key.
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=
# OLLAMA_MODEL_FALLBACK=qwen3-coder:480b-cloud

# ──────────────────────────────────────────────────────────────────────
# Skills
# ──────────────────────────────────────────────────────────────────────
# Activación automática por palabras lanzaderas (skills/triggers.json).
# 1 = activada (por defecto) · 0 = sólo activación manual con `use <skill>`.
SKILL_AUTO_ACTIVATE=1

# ──────────────────────────────────────────────────────────────────────
# Shodan
# CLI oficial: `pip install shodan`  ·  espera SHODAN_API_KEY o ~/.shodan/api_key
# ──────────────────────────────────────────────────────────────────────
SHODAN_API_KEY=

# ──────────────────────────────────────────────────────────────────────
# Censys (Search v2)
# CLI: `pip install censys`  ·  espera CENSYS_API_ID + CENSYS_API_SECRET
# Si tu cuenta usa "API tokens" del nuevo Censys Platform, ése es CENSYS_API_TOKEN.
# ──────────────────────────────────────────────────────────────────────
CENSYS_API_ID=
CENSYS_API_SECRET=
CENSYS_API_TOKEN=

# ──────────────────────────────────────────────────────────────────────
# Otras APIs típicas en recon (opcionales)
# ──────────────────────────────────────────────────────────────────────
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=
CHAOS_API_KEY=
GITHUB_TOKEN=
HUNTERIO_API_KEY=

# WPScan (https://wpscan.com/api)
WPSCAN_API_TOKEN=

# Have I Been Pwned
HIBP_API_KEY=
